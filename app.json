{
  "expo": {
    "name": "WiselyDocs",
    "slug": "doc-library-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C1322"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Doc Library uses your camera to scan documents.",
        "NSPhotoLibraryUsageDescription": "Doc Library uses your photo library to import documents.",
        "NSFaceIDUsageDescription": "Doc Library uses Face ID to secure your documents."
      }
    },
    "android": {
      "package": "com.nadir958.doclibrary",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C1322"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "doc-library",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Doc Library uses your camera to scan documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Doc Library uses your photo library to import documents."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Doc Library uses Face ID to protect your documents."
        }
      ],
      "expo-localization",
      "@react-native-ml-kit/text-recognition",
      "react-native-document-scanner-plugin"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2e8408c-7e75-4bb9-8107-72a7cbf5786c"
      }
    }
  }
}
